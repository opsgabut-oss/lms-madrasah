<%- include('../layouts/header') %>
<%- include('../layouts/navbar') %>

<div class="flex-1 flex max-w-7xl w-full mx-auto">
    <%- include('../layouts/sidebar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-black text-slate-800 tracking-tight">Ujian Online (CBT) Super Aman</h1>
                <p class="text-xs sm:text-sm text-slate-500 font-medium">Pengelolaan ujian daring dengan acak soal, fullscreen enforcement, dan audit kecurangan</p>
            </div>
            <a href="/guru/exams/create" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-brand-500 hover:bg-brand-600 text-slate-900 font-black text-sm shadow-lg shadow-brand-500/20 transition-all hover:scale-105">
                <i class="fas fa-plus"></i> Buat Ujian CBT Baru
            </a>
        </div>

        <% if (message) { %>
            <div class="p-4 rounded-xl text-sm font-bold flex items-center gap-3 <%= message.type === 'success' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-red-50 text-red-700 border border-red-200' %>">
                <i class="fas <%= message.type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle' %> text-lg"></i>
                <span><%= message.text %></span>
            </div>
        <% } %>

        <div class="space-y-4">
            <% if (exams.length === 0) { %>
                <div class="bg-white p-12 rounded-3xl border border-dashed border-slate-300 text-center text-slate-400">
                    <i class="fas fa-laptop-code text-4xl mb-3 text-slate-300"></i>
                    <h3 class="font-bold text-base text-slate-700">Belum ada ujian dibuat</h3>
                    <p class="text-xs mt-1">Klik tombol "Buat Ujian CBT Baru" di atas untuk memulai evaluasi daring siswa.</p>
                </div>
            <% } else { %>
                <% exams.forEach(function(ex) { %>
                    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm hover:shadow-md transition-all flex flex-col md:flex-row md:items-center justify-between gap-5">
                        <div class="space-y-3">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="px-3 py-1 rounded-full text-xs font-black bg-brand-50 text-brand-700 border border-brand-200">
                                    <%= ex.class_grade %> • <%= ex.class_name %>
                                </span>
                                <span class="px-2.5 py-0.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-700">
                                    <i class="far fa-clock mr-1 text-slate-400"></i> <%= ex.duration_minutes %> Menit
                                </span>
                                <span class="px-2.5 py-0.5 rounded-lg text-xs font-bold bg-purple-50 text-purple-700 border border-purple-200">
                                    <i class="fas fa-shield-alt mr-1"></i> Mode Anti-Cheat Aktif (Tol. <%= ex.tab_switch_limit %>x)
                                </span>
                            </div>

                            <h2 class="text-lg font-black text-slate-800"><%= ex.title %></h2>
                            <p class="text-xs text-slate-500 max-w-2xl"><%= ex.description %></p>
                            
                            <div class="text-[11px] font-semibold text-slate-400 flex items-center gap-4">
                                <span><i class="far fa-calendar-check mr-1"></i> Mulai: <%= ex.start_time %></span>
                                <span><i class="far fa-calendar-times mr-1"></i> Selesai: <%= ex.end_time %></span>
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 shrink-0">
                            <a href="/guru/exams/<%= ex.id %>/questions" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs flex items-center justify-center gap-2 transition-all">
                                <i class="fas fa-list-ol text-slate-500"></i>
                                <span>Bank Soal (<%= ex.question_count %>)</span>
                            </a>
                            <a href="/guru/exams/<%= ex.id %>/results" class="px-5 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-slate-900 font-black text-xs flex items-center justify-center gap-2 transition-all shadow-md shadow-brand-500/20">
                                <i class="fas fa-poll"></i>
                                <span>Hasil & Audit Nilai (<%= ex.student_attempt_count %>)</span>
                            </a>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </main>
</div>

<%- include('../layouts/footer') %>
