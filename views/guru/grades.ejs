<%- include('../layouts/header') %>
<%- include('../layouts/navbar') %>

<div class="flex-1 flex max-w-7xl w-full mx-auto">
    <%- include('../layouts/sidebar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-black text-slate-800 tracking-tight">Rekapitulasi Nilai Siswa</h1>
                <p class="text-xs sm:text-sm text-slate-500 font-medium">Kalkulasi otomatis dari Tugas (30%), Ujian CBT (50%), dan Kehadiran (20%)</p>
            </div>
            <% if (selectedClassId) { %>
                <div class="flex items-center gap-2">
                    <a href="/guru/grades/<%= selectedClassId %>/print" target="_blank" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition-all shadow">
                        <i class="fas fa-print"></i> Cetak Format Rapor
                    </a>
                </div>
            <% } %>
        </div>

        <!-- Class Filter Bar -->
        <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3 w-full sm:w-auto">
                <span class="text-xs font-bold uppercase text-slate-400">Pilih Kelas:</span>
                <form action="/guru/grades" method="GET" class="flex-1 sm:flex-initial">
                    <select name="class_id" onchange="this.form.submit()" class="px-4 py-2 rounded-xl border border-slate-200 bg-slate-50 font-bold text-xs text-slate-800 outline-none focus:ring-2 focus:ring-brand-500">
                        <% classes.forEach(function(cls) { %>
                            <option value="<%= cls.id %>" <%= selectedClassId == cls.id ? 'selected' : '' %>>
                                <%= cls.grade %> - <%= cls.name %>
                            </option>
                        <% }); %>
                    </select>
                </form>
            </div>

            <% if (currentClass) { %>
                <div class="text-xs font-bold text-slate-500">
                    Menampilkan nilai untuk <strong class="text-slate-800"><%= currentClass.name %></strong>
                </div>
            <% } %>
        </div>

        <!-- Gradebook Table -->
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-slate-500 font-bold uppercase text-[11px] tracking-wider border-b border-slate-200">
                        <tr>
                            <th class="py-4 px-6">No</th>
                            <th class="py-4 px-6">Nama Siswa</th>
                            <th class="py-4 px-6">NIS</th>
                            <th class="py-4 px-6 text-center">Rata Tugas (30%)</th>
                            <th class="py-4 px-6 text-center">Rata CBT (50%)</th>
                            <th class="py-4 px-6 text-center">Kehadiran (20%)</th>
                            <th class="py-4 px-6 text-center">Nilai Akhir</th>
                            <th class="py-4 px-6 text-center">Predikat</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (gradeData.length === 0) { %>
                            <tr>
                                <td colspan="8" class="text-center py-8 text-xs text-slate-400">
                                    Belum ada data siswa di kelas yang dipilih.
                                </td>
                            </tr>
                        <% } else { %>
                            <% gradeData.forEach(function(g, idx) { %>
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-4 px-6 font-bold text-slate-400"><%= idx + 1 %></td>
                                    <td class="py-4 px-6 font-bold text-slate-800 flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-slate-800 text-white flex items-center justify-center font-bold text-xs">
                                            <%= g.student.name.charAt(0) %>
                                        </div>
                                        <span><%= g.student.name %></span>
                                    </td>
                                    <td class="py-4 px-6 font-mono text-xs font-bold text-brand-700"><%= g.student.identity_number %></td>
                                    <td class="py-4 px-6 text-center font-bold text-slate-700"><%= g.assignmentAvg %></td>
                                    <td class="py-4 px-6 text-center font-bold text-slate-700"><%= g.examAvg %></td>
                                    <td class="py-4 px-6 text-center font-bold text-slate-700"><%= g.attendancePct %>%</td>
                                    <td class="py-4 px-6 text-center">
                                        <span class="px-3 py-1 rounded-full text-xs font-black <%= g.finalScore >= 75 ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-red-50 text-red-700 border border-red-200' %>">
                                            <%= g.finalScore %>
                                        </span>
                                    </td>
                                    <td class="py-4 px-6 text-center font-black text-xs">
                                        <% if (g.finalScore >= 90) { %>
                                            <span class="text-emerald-600">A (Sangat Baik)</span>
                                        <% } else if (g.finalScore >= 75) { %>
                                            <span class="text-blue-600">B (Baik)</span>
                                        <% } else if (g.finalScore >= 60) { %>
                                            <span class="text-amber-600">C (Cukup)</span>
                                        <% } else { %>
                                            <span class="text-red-500">D (Perlu Bimbingan)</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<%- include('../layouts/footer') %>
