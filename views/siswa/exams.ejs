<%- include('../layouts/header') %>
<%- include('../layouts/navbar') %>

<div class="flex-1 flex max-w-7xl w-full mx-auto">
    <%- include('../layouts/sidebar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6">
        <div>
            <h1 class="text-2xl font-black text-slate-800 tracking-tight">Ujian Online (CBT)</h1>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">Jadwal evaluasi daring dengan mode proteksi anti-kecurangan</p>
        </div>

        <div class="space-y-4">
            <% if (exams.length === 0) { %>
                <div class="bg-white p-12 rounded-3xl border border-dashed border-slate-300 text-center text-slate-400">
                    <i class="fas fa-laptop-code text-4xl mb-3 text-slate-300"></i>
                    <h3 class="font-bold text-base text-slate-700">Tidak ada ujian terjadwal</h3>
                    <p class="text-xs mt-1">Ujian online akan tampil di sini jika guru pengampu telah membuka jadwal.</p>
                </div>
            <% } else { %>
                <% exams.forEach(function(ex) { %>
                    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm hover:shadow-md transition-all flex flex-col md:flex-row md:items-center justify-between gap-5">
                        <div class="space-y-2">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="px-3 py-1 rounded-full text-xs font-black bg-brand-50 text-brand-700 border border-brand-200">
                                    <%= ex.class_name %>
                                </span>
                                <span class="px-2.5 py-0.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-700">
                                    <i class="far fa-clock mr-1 text-slate-400"></i> <%= ex.duration_minutes %> Menit
                                </span>
                                <span class="px-2.5 py-0.5 rounded-lg text-xs font-bold bg-purple-50 text-purple-700 border border-purple-200">
                                    <i class="fas fa-shield-alt mr-1"></i> Anti-Cheat Aktif
                                </span>
                            </div>

                            <h2 class="text-lg font-black text-slate-800"><%= ex.title %></h2>
                            <p class="text-xs text-slate-500 max-w-2xl"><%= ex.description %></p>
                            
                            <div class="text-[11px] font-semibold text-slate-400 flex items-center gap-4">
                                <span><i class="far fa-calendar-check mr-1"></i> Mulai: <%= ex.start_time %></span>
                                <span><i class="far fa-calendar-times mr-1"></i> Berakhir: <%= ex.end_time %></span>
                            </div>
                        </div>

                        <div class="flex items-center gap-3 shrink-0">
                            <% if (ex.session_status === 'submitted') { %>
                                <div class="text-right">
                                    <span class="px-3 py-1 rounded-full text-xs font-black bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        Sudah Dikerjakan • Nilai: <%= ex.total_score %>
                                    </span>
                                </div>
                                <a href="/siswa/exams/<%= ex.id %>/result" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition-colors">
                                    Lihat Hasil Ujian
                                </a>
                            <% } else { %>
                                <a href="/siswa/exams/<%= ex.id %>/room" class="px-6 py-3 rounded-xl bg-brand-500 hover:bg-brand-600 text-slate-900 font-black text-xs flex items-center gap-2 shadow-lg shadow-brand-500/20 transition-all hover:scale-105">
                                    <i class="fas fa-play text-[10px]"></i>
                                    <span>Mulai Ujian Sekarang</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </main>
</div>

<%- include('../layouts/footer') %>
