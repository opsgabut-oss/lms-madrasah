<%- include('../layouts/header') %>
<%- include('../layouts/navbar') %>

<div class="flex-1 flex max-w-7xl w-full mx-auto">
    <%- include('../layouts/sidebar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6">
        <!-- Class Hero Header -->
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-8 relative overflow-hidden">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="px-3 py-1 rounded-full text-xs font-black bg-brand-50 text-brand-700 border border-brand-200">
                            <%= currentClass.grade %>
                        </span>
                        <span class="text-xs font-bold text-slate-400">• <%= currentClass.subject %></span>
                    </div>
                    <h1 class="text-2xl sm:text-3xl font-black text-slate-800 tracking-tight">
                        <%= currentClass.name %>
                    </h1>
                    <div class="text-xs font-semibold text-slate-500 mt-2 flex items-center gap-2">
                        <i class="fas fa-chalkboard-teacher text-brand-600"></i>
                        <span>Guru Pengampu: <strong><%= currentClass.teacher_name %></strong> (<%= currentClass.teacher_email || 'Email guru' %>)</span>
                    </div>
                </div>

                <div class="bg-slate-50 border border-slate-200 px-4 py-2.5 rounded-2xl">
                    <div class="text-[10px] font-black uppercase tracking-wider text-slate-400">Kode Kelas</div>
                    <div class="text-base font-mono font-black text-slate-800"><%= currentClass.code %></div>
                </div>
            </div>

            <!-- Tabs Navigation -->
            <div class="mt-8 flex items-center gap-2 overflow-x-auto border-b border-slate-100 pb-2">
                <a href="/siswa/classes/<%= currentClass.id %>?tab=materials" class="px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm whitespace-nowrap transition-all flex items-center gap-2 <%= tab === 'materials' ? 'bg-brand-500 text-slate-900 shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
                    <i class="fas fa-book-reader"></i> Materi Pelajaran (<%= materials.length %>)
                </a>
                <a href="/siswa/classes/<%= currentClass.id %>?tab=assignments" class="px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm whitespace-nowrap transition-all flex items-center gap-2 <%= tab === 'assignments' ? 'bg-brand-500 text-slate-900 shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
                    <i class="fas fa-tasks"></i> Tugas Mandiri (<%= assignments.length %>)
                </a>
                <a href="/siswa/classes/<%= currentClass.id %>?tab=exams" class="px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm whitespace-nowrap transition-all flex items-center gap-2 <%= tab === 'exams' ? 'bg-brand-500 text-slate-900 shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
                    <i class="fas fa-laptop-code"></i> Ujian CBT (<%= exams.length %>)
                </a>
                <a href="/siswa/classes/<%= currentClass.id %>?tab=attendances" class="px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm whitespace-nowrap transition-all flex items-center gap-2 <%= tab === 'attendances' ? 'bg-brand-500 text-slate-900 shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
                    <i class="fas fa-calendar-check"></i> Presensi Kehadiran (<%= attendances.length %>)
                </a>
                <a href="/siswa/classes/<%= currentClass.id %>?tab=forum" class="px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm whitespace-nowrap transition-all flex items-center gap-2 <%= tab === 'forum' ? 'bg-brand-500 text-slate-900 shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
                    <i class="fas fa-comments"></i> Forum Diskusi (<%= discussions.length %>)
                </a>
            </div>
        </div>

        <% if (message) { %>
            <div class="p-4 rounded-xl text-sm font-bold flex items-center gap-3 <%= message.type === 'success' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-red-50 text-red-700 border border-red-200' %>">
                <i class="fas <%= message.type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle' %> text-lg"></i>
                <span><%= message.text %></span>
            </div>
        <% } %>

        <!-- TAB 1: MATERI PELAJARAN -->
        <% if (tab === 'materials') { %>
            <div class="space-y-4">
                <% if (materials.length === 0) { %>
                    <div class="bg-white p-10 rounded-3xl border border-dashed border-slate-300 text-center text-slate-400">
                        <i class="fas fa-book-open text-3xl mb-2 text-slate-300"></i>
                        <p class="font-bold text-sm text-slate-600">Belum ada materi pembelajaran</p>
                    </div>
                <% } else { %>
                    <% materials.forEach(function(mat) { %>
                        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm space-y-4">
                            <div class="flex items-start justify-between gap-4">
                                <div class="flex items-start gap-4">
                                    <div class="w-10 h-10 rounded-xl <%= mat.is_completed ? 'bg-emerald-500 text-white' : 'bg-emerald-50 text-emerald-600' %> flex items-center justify-center font-black text-sm shrink-0">
                                        <% if (mat.is_completed) { %>
                                            <i class="fas fa-check"></i>
                                        <% } else { %>
                                            #<%= mat.meeting_number %>
                                        <% } %>
                                    </div>
                                    <div>
                                        <span class="text-[10px] font-black uppercase tracking-wider text-emerald-600">Pertemuan Ke-<%= mat.meeting_number %></span>
                                        <h3 class="text-base font-black text-slate-800"><%= mat.title %></h3>
                                        <div class="text-[11px] text-slate-400 mt-0.5"><i class="far fa-clock mr-1"></i> <%= mat.created_at %></div>
                                    </div>
                                </div>

                                <form action="/siswa/materials/<%= mat.id %>/toggle" method="POST">
                                    <input type="hidden" name="class_id" value="<%= currentClass.id %>">
                                    <button type="submit" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 <%= mat.is_completed ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-slate-100 hover:bg-slate-200 text-slate-700' %>">
                                        <i class="fas <%= mat.is_completed ? 'fa-check-circle text-emerald-600' : 'fa-circle text-slate-400' %>"></i>
                                        <span><%= mat.is_completed ? 'Selesai Dipelajari' : 'Tandai Selesai' %></span>
                                    </button>
                                </form>
                            </div>

                            <% if (mat.content) { %>
                                <div class="text-sm text-slate-600 bg-slate-50 p-4 rounded-2xl whitespace-pre-line leading-relaxed border border-slate-100">
                                    <%= mat.content %>
                                </div>
                            <% } %>

                            <% if (mat.video_url) { %>
                                <% const isCanva = mat.video_url.includes('canva.com') || mat.video_url.includes('canva.link') || mat.video_url.includes('canva'); %>
                                <% if (isCanva) { %>
                                    <!-- Canva Presentation Showcase Card -->
                                    <div class="rounded-3xl p-5 sm:p-6 bg-gradient-to-r from-purple-950 via-slate-900 to-cyan-950 text-white shadow-lg border border-purple-900/40 space-y-4 max-w-2xl relative overflow-hidden">
                                        <div class="absolute -right-8 -bottom-8 w-48 h-48 bg-cyan-400/10 rounded-full blur-2xl pointer-events-none"></div>
                                        
                                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-12 h-12 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-2xl text-cyan-300 shrink-0 shadow-inner">
                                                    <i class="fas fa-desktop"></i>
                                                </div>
                                                <div>
                                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-cyan-400 text-slate-950">
                                                        Canva Presentation
                                                    </span>
                                                    <h4 class="text-sm sm:text-base font-black text-white mt-1">Slide Pembelajaran Canva</h4>
                                                    <p class="text-xs text-slate-300">Presentasi interaktif dengan animasi & transisi</p>
                                                </div>
                                            </div>

                                            <a href="<%= mat.video_url.replace('?embed', '').replace('&embed', '') %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-400 to-teal-400 hover:from-cyan-300 hover:to-teal-300 text-slate-950 font-black text-xs shadow-lg shadow-cyan-500/20 transition-all hover:scale-105 shrink-0">
                                                <i class="fas fa-external-link-alt"></i>
                                                <span>Buka Slide Canva</span>
                                            </a>
                                        </div>

                                        <div class="rounded-2xl overflow-hidden aspect-video w-full border border-white/10 bg-slate-950 shadow-inner relative">
                                            <iframe class="w-full h-full" src="<%= mat.video_url %>" title="Slide Canva" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                                        </div>

                                        <div class="p-3 rounded-xl bg-white/5 border border-white/10 text-xs text-slate-300 flex items-center gap-2">
                                            <i class="fas fa-info-circle text-cyan-400 text-sm shrink-0"></i>
                                            <span>Jika tampilan slide di atas menampilkan <em>"refused to connect"</em>, silakan klik tombol <strong>"Buka Slide Canva"</strong> di atas untuk membuka presentasi langsung di tab baru.</span>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <div class="space-y-2">
                                        <div class="flex items-center gap-2">
                                            <% if (mat.video_url.includes('youtube.com')) { %>
                                                <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-red-50 text-red-700 border border-red-200">
                                                    <i class="fab fa-youtube mr-1"></i> Video Pembelajaran YouTube
                                                </span>
                                            <% } else { %>
                                                <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-slate-100 text-slate-700 border border-slate-200">
                                                    <i class="fas fa-play-circle mr-1"></i> Media Pembelajaran
                                                </span>
                                            <% } %>
                                        </div>
                                        <div class="rounded-2xl overflow-hidden aspect-video max-w-2xl border border-slate-200 shadow-sm bg-black">
                                            <iframe class="w-full h-full" src="<%= mat.video_url %>" title="Media Pembelajaran" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                                        </div>
                                    </div>
                                <% } %>
                            <% } %>

                            <% if (mat.attachment_path) { %>
                                <%
                                    let sFileExt = (mat.attachment_name || '').split('.').pop().toLowerCase();
                                    let sFileIcon = 'fa-file-alt text-slate-600';
                                    let sFileLabel = 'Dokumen Lampiran';
                                    if (['ppt', 'pptx'].includes(sFileExt)) {
                                        sFileIcon = 'fa-file-powerpoint text-amber-600';
                                        sFileLabel = 'Slide Presentasi PowerPoint (PPT)';
                                    } else if (sFileExt === 'pdf') {
                                        sFileIcon = 'fa-file-pdf text-red-500';
                                        sFileLabel = 'Dokumen PDF';
                                    } else if (['doc', 'docx'].includes(sFileExt)) {
                                        sFileIcon = 'fa-file-word text-blue-600';
                                        sFileLabel = 'Dokumen Word';
                                    } else if (['xls', 'xlsx'].includes(sFileExt)) {
                                        sFileIcon = 'fa-file-excel text-emerald-600';
                                        sFileLabel = 'Spreadsheet Excel';
                                    }
                                %>
                                <div class="inline-flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs font-bold text-slate-800 shadow-sm">
                                    <i class="fas <%= sFileIcon %> text-xl"></i>
                                    <div class="text-left">
                                        <div class="font-black text-slate-800"><%= mat.attachment_name || 'Berkas Lampiran Materi' %></div>
                                        <div class="text-[10px] text-slate-400 font-semibold uppercase"><%= sFileLabel %></div>
                                    </div>
                                    <a href="<%= mat.attachment_path %>" target="_blank" download class="ml-3 px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-brand-700 hover:bg-brand-50 font-black text-xs transition-colors flex items-center gap-1.5 shadow-xs">
                                        <i class="fas fa-download"></i> Unduh File
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        <% } %>

        <!-- TAB 2: TUGAS MANDIRI -->
        <% if (tab === 'assignments') { %>
            <div class="space-y-4">
                <% if (assignments.length === 0) { %>
                    <div class="bg-white p-10 rounded-3xl border border-dashed border-slate-300 text-center text-slate-400">
                        <i class="fas fa-tasks text-3xl mb-2 text-slate-300"></i>
                        <p class="font-bold text-sm text-slate-600">Belum ada tugas untuk kelas ini</p>
                    </div>
                <% } else { %>
                    <% assignments.forEach(function(asg) { %>
                        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm hover:shadow-md transition-all flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div class="space-y-2">
                                <div class="flex items-center gap-2">
                                    <% if (asg.submission_id) { %>
                                        <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <i class="fas fa-check-circle"></i> Sudah Diserahkan
                                        </span>
                                    <% } else { %>
                                        <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-amber-50 text-amber-700 border border-amber-200">
                                            <i class="fas fa-hourglass-half"></i> Belum Mengumpulkan
                                        </span>
                                    <% } %>
                                    <span class="text-xs font-bold text-slate-400 flex items-center gap-1">
                                        <i class="far fa-clock"></i> Batas: <%= asg.deadline %>
                                    </span>
                                </div>
                                <h3 class="text-base font-black text-slate-800"><%= asg.title %></h3>
                                <p class="text-xs text-slate-500 line-clamp-2"><%= asg.instructions %></p>
                            </div>

                            <div class="flex items-center gap-3 shrink-0">
                                <% if (asg.score !== null) { %>
                                    <div class="px-3 py-1.5 rounded-xl bg-brand-50 border border-brand-200 text-center">
                                        <div class="text-[10px] font-bold text-brand-700 uppercase">Nilai</div>
                                        <div class="text-base font-black text-slate-800"><%= asg.score %></div>
                                    </div>
                                <% } %>
                                <a href="/siswa/assignments/<%= asg.id %>" class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs flex items-center gap-2 transition-all shadow">
                                    <span><%= asg.submission_id ? 'Lihat / Perbarui' : 'Kerjakan Tugas' %></span>
                                    <i class="fas fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        <% } %>

        <!-- TAB 3: UJIAN ONLINE CBT -->
        <% if (tab === 'exams') { %>
            <div class="space-y-4">
                <% if (exams.length === 0) { %>
                    <div class="bg-white p-10 rounded-3xl border border-dashed border-slate-300 text-center text-slate-400">
                        <i class="fas fa-laptop-code text-3xl mb-2 text-slate-300"></i>
                        <p class="font-bold text-sm text-slate-600">Belum ada ujian online CBT</p>
                    </div>
                <% } else { %>
                    <% exams.forEach(function(ex) { %>
                        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm hover:shadow-md transition-all flex flex-col md:flex-row md:items-center justify-between gap-5">
                            <div class="space-y-2">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-purple-50 text-purple-700 border border-purple-200">
                                        <i class="fas fa-shield-alt mr-1"></i> Anti-Cheat Aktif
                                    </span>
                                    <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-bold bg-slate-100 text-slate-600">
                                        Durasi: <%= ex.duration_minutes %> Menit
                                    </span>
                                </div>
                                <h3 class="text-base font-black text-slate-800"><%= ex.title %></h3>
                                <p class="text-xs text-slate-500 line-clamp-1"><%= ex.description %></p>
                            </div>

                            <div class="flex items-center gap-3 shrink-0">
                                <% if (ex.session_status === 'submitted') { %>
                                    <div class="text-right">
                                        <span class="px-3 py-1 rounded-full text-xs font-black bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            Selesai • Nilai: <%= ex.total_score %>
                                        </span>
                                    </div>
                                    <a href="/siswa/exams/<%= ex.id %>/result" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs">
                                        Lihat Hasil
                                    </a>
                                <% } else { %>
                                    <a href="/siswa/exams/<%= ex.id %>/room" class="px-5 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-slate-900 font-black text-xs flex items-center gap-2 shadow-md shadow-brand-500/20">
                                        <i class="fas fa-play text-[10px]"></i>
                                        <span>Masuk Ruang Ujian</span>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        <% } %>

        <!-- TAB 4: PRESENSI KELAS -->
        <% if (tab === 'attendances') { %>
            <div class="space-y-4">
                <% if (attendances.length === 0) { %>
                    <div class="bg-white p-10 rounded-3xl border border-dashed border-slate-300 text-center text-slate-400">
                        <i class="fas fa-calendar-check text-3xl mb-2 text-slate-300"></i>
                        <p class="font-bold text-sm text-slate-600">Belum ada sesi presensi untuk kelas ini</p>
                    </div>
                <% } else { %>
                    <% attendances.forEach(function(att) { %>
                        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div class="space-y-1">
                                <div class="text-xs font-bold text-slate-400">
                                    <i class="far fa-calendar-alt text-brand-500 mr-1"></i> <%= att.date %> (<%= att.start_time %> - <%= att.end_time %> WIB)
                                </div>
                                <h3 class="text-base font-black text-slate-800"><%= att.title %></h3>
                            </div>

                            <div class="shrink-0">
                                <% if (att.attendance_status) { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold <%= att.attendance_status === 'Hadir' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-amber-50 text-amber-700 border border-amber-200' %>">
                                        <i class="fas fa-check-circle"></i> <%= att.attendance_status %>
                                    </span>
                                <% } else { %>
                                    <form action="/siswa/attendances/<%= att.id %>/checkin" method="POST">
                                        <input type="hidden" name="class_id" value="<%= currentClass.id %>">
                                        <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-slate-900 font-black text-xs shadow-md shadow-brand-500/20 transition-all">
                                            <i class="fas fa-check mr-1"></i> Isi Kehadiran (Hadir)
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        <% } %>

        <!-- TAB 5: FORUM DISKUSI -->
        <% if (tab === 'forum') { %>
            <div class="space-y-6">
                <!-- Create Thread -->
                <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm">
                    <h3 class="text-base font-black text-slate-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-question-circle text-brand-500"></i> Ajukan Pertanyaan / Diskusi
                    </h3>
                    <form action="/siswa/classes/<%= currentClass.id %>/forum/create" method="POST" class="space-y-3">
                        <input type="text" name="title" required placeholder="Judul pertanyaan..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white text-sm font-semibold">
                        <textarea name="content" rows="3" required placeholder="Tuliskan pertanyaan atau kendala Anda di sini..." class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white text-sm text-slate-800"></textarea>
                        <div class="flex justify-end">
                            <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-slate-900 font-black text-xs shadow-md transition-all">
                                Kirim Pertanyaan
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Discussion Threads -->
                <div class="space-y-4">
                    <% if (discussions.length === 0) { %>
                        <div class="bg-white p-10 rounded-3xl border border-dashed border-slate-300 text-center text-slate-400">
                            <i class="fas fa-comments text-3xl mb-2 text-slate-300"></i>
                            <p class="font-bold text-sm text-slate-600">Belum ada diskusi di kelas ini</p>
                        </div>
                    <% } else { %>
                        <% discussions.forEach(function(disc) { %>
                            <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm space-y-4">
                                <div class="flex items-start justify-between">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl <%= disc.author_role === 'guru' ? 'bg-emerald-600' : 'bg-slate-800' %> text-white flex items-center justify-center font-bold text-sm shadow-sm">
                                            <%= disc.author_name.charAt(0) %>
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <h4 class="font-extrabold text-sm text-slate-800"><%= disc.author_name %></h4>
                                                <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase <%= disc.author_role === 'guru' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700' %>">
                                                    <%= disc.author_role %>
                                                </span>
                                            </div>
                                            <div class="text-[11px] text-slate-400"><%= disc.created_at %></div>
                                        </div>
                                    </div>
                                    <span class="text-xs font-bold text-slate-400 flex items-center gap-1">
                                        <i class="fas fa-comment-dots"></i> <%= disc.reply_count %> Balasan
                                    </span>
                                </div>

                                <div>
                                    <h3 class="text-base font-black text-slate-800 mb-1"><%= disc.title %></h3>
                                    <p class="text-sm text-slate-600 leading-relaxed whitespace-pre-line"><%= disc.content %></p>
                                </div>

                                <!-- Replies Form -->
                                <form action="/siswa/forum/<%= disc.id %>/reply" method="POST" class="pt-3 border-t border-slate-100 flex gap-2">
                                    <input type="hidden" name="class_id" value="<%= currentClass.id %>">
                                    <input type="text" name="reply" required placeholder="Tulis balasan..." class="flex-1 px-4 py-2 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white text-xs font-medium">
                                    <button type="submit" class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs">
                                        Kirim
                                    </button>
                                </form>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        <% } %>

    </main>
</div>

<%- include('../layouts/footer') %>
