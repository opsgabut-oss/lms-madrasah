<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lupa Kata Sandi | LMS Platform - Oemah Sinau</title>
    <link rel="icon" type="image/png" href="https://lms.oemahsinau.online/favicon.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Outfit', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex items-center justify-center p-6 selection:bg-emerald-500 selection:text-white">

    <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-100 p-8 sm:p-10">
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-teal-700 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-emerald-500/30">
                <i class="fas fa-key text-2xl text-white"></i>
            </div>
            <h2 class="text-2xl font-black text-slate-800">Lupa Kata Sandi?</h2>
            <p class="text-sm text-slate-500 mt-2">Masukkan email Anda untuk menerima instruksi pemulihan kata sandi akun.</p>
        </div>

        <% if (error) { %>
            <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-semibold flex items-center gap-3">
                <i class="fas fa-exclamation-circle text-red-500 text-lg"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm font-semibold flex items-center gap-3">
                <i class="fas fa-check-circle text-green-500 text-lg"></i>
                <span><%= success %></span>
            </div>
        <% } %>

        <form action="/auth/attemptForgotPassword" method="POST" class="space-y-5">
            <div>
                <label for="email" class="block text-sm font-bold mb-2 text-slate-700">Alamat Email Terdaftar</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <input type="email" name="email" id="email" required placeholder="nama@sekolah.com" class="w-full pl-11 pr-4 py-3.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-emerald-500 outline-none text-slate-800 font-medium transition-all">
                </div>
            </div>

            <button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-3.5 rounded-xl shadow-lg transition-all hover:-translate-y-0.5">
                Kirim Tautan Pemulihan <i class="fas fa-paper-plane ml-1"></i>
            </button>
        </form>

        <div class="mt-8 pt-6 border-t border-slate-100 text-center">
            <a href="/auth/login" class="text-sm font-bold text-emerald-600 hover:text-emerald-700 flex items-center justify-center gap-2">
                <i class="fas fa-arrow-left"></i> Kembali ke Halaman Masuk
            </a>
        </div>
    </div>

</body>
</html>
