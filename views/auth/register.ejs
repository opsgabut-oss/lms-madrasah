<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Akun Guru | LMS Platform - Oemah Sinau</title>
    <link rel="icon" type="image/png" href="https://lms.oemahsinau.online/favicon.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        @keyframes blob {
            0% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }
        .animate-blob { animation: blob 7s infinite; }
        .animation-delay-2000 { animation-delay: 2s; }
        .animation-delay-4000 { animation-delay: 4s; }
        body { font-family: 'Outfit', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased min-h-screen flex items-center justify-center relative overflow-x-hidden selection:bg-green-500 selection:text-white py-12">

    <div class="fixed top-[-10%] left-[-10%] w-72 md:w-96 h-72 md:h-96 bg-green-300 rounded-full mix-blend-multiply filter blur-[80px] opacity-70 animate-blob z-0"></div>
    <div class="fixed top-[20%] right-[-10%] w-72 md:w-96 h-72 md:h-96 bg-emerald-200 rounded-full mix-blend-multiply filter blur-[80px] opacity-70 animate-blob animation-delay-2000 z-0"></div>
    <div class="fixed bottom-[-20%] left-[20%] w-72 md:w-96 h-72 md:h-96 bg-teal-200 rounded-full mix-blend-multiply filter blur-[80px] opacity-70 animate-blob animation-delay-4000 z-0"></div>

    <div class="w-full max-w-2xl px-6 relative z-10">
        
        <div class="bg-white/80 backdrop-blur-xl rounded-[2.5rem] shadow-2xl border border-white p-8 md:p-10 transform transition-all duration-300 hover:shadow-green-900/10">
            
            <div class="text-center mb-8 border-b border-gray-100 pb-8">
                <% if (typeof school !== 'undefined' && school && school.logo) { %>
                    <div class="w-20 h-20 bg-white rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-md p-2 border border-gray-100">
                        <img src="<%= school.logo %>" alt="Logo" class="max-h-full max-w-full object-contain">
                    </div>
                <% } else { %>
                    <div class="w-16 h-16 bg-gradient-to-br from-green-500 to-emerald-700 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-green-500/30 transform -rotate-3 hover:rotate-0 transition-transform">
                        <i class="fas fa-user-plus text-2xl text-white"></i>
                    </div>
                <% } %>
                <h2 class="text-2xl md:text-3xl font-black text-gray-800 tracking-tight">Daftar Akun Guru</h2>
                <p class="text-sm text-gray-500 mt-2 font-medium">
                    <%= (typeof school !== 'undefined' && school && school.name) ? school.name : 'Bergabunglah dan kelola kelas Anda dengan lebih cerdas.' %>
                </p>
            </div>

            <% if (error) { %>
                <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-semibold flex items-center gap-3">
                    <i class="fas fa-exclamation-circle text-red-500 text-lg"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/auth/attemptRegister" method="POST" class="space-y-5">
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label for="name" class="block text-sm font-bold mb-2 text-gray-700">Nama Lengkap & Gelar</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-user text-gray-400"></i>
                            </div>
                            <input type="text" name="name" id="name" value="" class="w-full pl-11 pr-4 py-3.5 rounded-xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all outline-none font-medium text-gray-700" placeholder="Contoh: Budi Santoso, S.Pd" required>
                        </div>
                    </div>
                    <div>
                        <label for="identity_number" class="block text-sm font-bold mb-2 text-gray-700">NIP / NUPTK</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-id-card text-gray-400"></i>
                            </div>
                            <input type="text" name="identity_number" id="identity_number" value="" class="w-full pl-11 pr-4 py-3.5 rounded-xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all outline-none font-medium text-gray-700" placeholder="Nomor Induk" required>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label for="email" class="block text-sm font-bold mb-2 text-gray-700">Alamat Email</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-envelope text-gray-400"></i>
                            </div>
                            <input type="email" name="email" id="email" value="" class="w-full pl-11 pr-4 py-3.5 rounded-xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all outline-none font-medium text-gray-700" placeholder="guru@sekolah.com" required>
                        </div>
                    </div>
                    <div>
                        <label for="password" class="block text-sm font-bold mb-2 text-gray-700">Kata Sandi</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-lock text-gray-400"></i>
                            </div>
                            <input type="password" name="password" id="password" class="w-full pl-11 pr-4 py-3.5 rounded-xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all outline-none font-medium text-gray-700" placeholder="Minimal 6 karakter" required minlength="6">
                        </div>
                    </div>
                </div>

                <div class="mt-8 p-6 bg-green-50/50 rounded-2xl border border-green-100">
                    <label class="block text-sm font-bold mb-2 text-green-800">Asal Sekolah / Instansi</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-building text-green-500"></i>
                        </div>
                        <select name="school_id" id="schoolSelect" class="w-full pl-11 pr-10 py-3.5 rounded-xl border border-green-200 bg-white focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all outline-none font-bold text-gray-700 cursor-pointer appearance-none" required onchange="checkSchool()">
                            <option value="">-- Silakan Pilih Sekolah Anda --</option>
                            <% schools.forEach(function(school) { %>
                                <option value="<%= school.id %>"><%= school.name %></option>
                            <% }); %>
                            <option value="other" class="text-green-700 bg-green-50 font-black">&#43; Tambahkan Sekolah Baru (Jika belum terdaftar)</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                            <i class="fas fa-chevron-down text-gray-400 text-sm"></i>
                        </div>
                    </div>

                    <div id="newSchoolDiv" class="hidden mt-4 pt-4 border-t border-green-200/50 transition-all">
                        <label class="block text-sm font-bold text-green-800 mb-2">Nama Sekolah Baru</label>
                        <input type="text" name="new_school_name" id="newSchoolInput" class="w-full px-4 py-3.5 rounded-xl border border-green-300 bg-white focus:ring-2 focus:ring-green-600 outline-none font-medium text-gray-800 shadow-inner" placeholder="Ketik nama sekolah lengkap...">
                        <p class="text-[11px] font-bold text-green-600 mt-2 uppercase tracking-wide"><i class="fas fa-info-circle mr-1"></i> Sekolah akan otomatis ditambahkan ke sistem.</p>
                    </div>
                </div>

                <button type="submit" class="w-full bg-gradient-to-r from-green-600 to-emerald-600 text-white font-black text-lg py-4 rounded-xl shadow-lg shadow-green-500/30 hover:shadow-green-500/50 transform hover:-translate-y-0.5 transition-all duration-200 mt-6">
                    Daftar Sekarang <i class="fas fa-paper-plane ml-2"></i>
                </button>
            </form>

            <div class="mt-8 text-center">
                <p class="text-sm text-gray-500 font-medium">
                    Sudah memiliki akun? 
                    <a href="/auth/login" class="font-bold text-green-600 hover:text-green-800 transition-colors ml-1 border-b-2 border-green-200 hover:border-green-600 pb-0.5">Masuk di sini</a>
                </p>
            </div>
        </div>

        <div class="text-center mt-8 pb-4">
            <p class="text-xs text-gray-400 font-medium mb-1">
                &copy; 2026 LMS System
            </p>
            <p class="text-xs font-bold text-gray-500 flex items-center justify-center gap-1.5">
                Developed with <i class="fas fa-heart text-red-500 animate-pulse"></i> by 
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-600 to-emerald-500 font-black tracking-widest uppercase">
                    Oemah Sinau
                </span>
            </p>
        </div>

    </div>

    <script>
        function checkSchool() {
            var select = document.getElementById("schoolSelect");
            var newSchoolDiv = document.getElementById("newSchoolDiv");
            var newSchoolInput = document.getElementById("newSchoolInput");
            
            if (select.value === "other") {
                newSchoolDiv.classList.remove("hidden");
                newSchoolInput.required = true;
                newSchoolInput.focus();
            } else {
                newSchoolDiv.classList.add("hidden");
                newSchoolInput.required = false;
                newSchoolInput.value = "";
            }
        }
    </script>
</body>
</html>
